{
  "name": "mcp-srv",
  "version": "0.2.0",
  "description": "A Model Context Protocol server for Upsun cloud platform integration",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "mcp-srv": "./build/index.js"
  },
  "scripts": {
    "clean": "rm -rf build",
    "run": "node build/index.js",
    "build": "tsc --noEmit && tsc -p tsconfig.json",
    "watch": "tsx watch src/index.ts",
    "inspector": "npx @modelcontextprotocol/inspector http://localhost:3000 --header 'upsun-api-token: xxxx'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:coverage:ci": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --ci --watchAll=false --passWithNoTests",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --ci --watchAll=false --passWithNoTests",
    "coverage:check": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --passWithNoTests"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0",
    "@modelcontextprotocol/node": "^2.1",
    "@modelcontextprotocol/server": "^2.3",
    "@opentelemetry/api": "^1.9",
    "@opentelemetry/auto-instrumentations-node": "^0.81",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223",
    "@opentelemetry/resources": "^2.12",
    "@opentelemetry/sdk-node": "^0.223",
    "@opentelemetry/semantic-conventions": "^1.39",
    "cors": "^2.8.6",
    "dotenv": "^18.0",
    "express": "^5.3",
    "pino": "^10.4",
    "pino-pretty": "^13.2",
    "upsun-sdk-node": "^0.7",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0",
    "@types/node": "^26.6.5",
    "@types/pino": "^7.0",
    "@types/supertest": "^7.2.1",
    "eslint": "10.12",
    "jest": "^30.5",
    "prettier": "^3.9",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4",
    "ts-node": "^10.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71"
  }
}
